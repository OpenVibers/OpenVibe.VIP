# OpenVibe.VIP — environment (development: .env; production: /etc/openvibe/vip.env).
# Names only here; never commit a value.

# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=4620
HOST=127.0.0.1
BASE_URL=http://localhost:4620
VIP_DB_PATH=./data/vip.db
# TRUST_PROXY=1

# ── OpenVibe.Network (identity) ──────────────────────────
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
# OV_NETWORK_ISSUER=https://openvibe.network
# OV_NETWORK_PUBLIC_KEY=            # optional; otherwise fetched from /api/.well-known/jwks
# VIP_AUDIENCE=openvibe.vip
# Client `vip`: service tokens (Billing, Events, Network) and browser sign-in
OV_OAUTH_CLIENT_ID=vip
OV_OAUTH_CLIENT_SECRET=
# OV_OAUTH_REDIRECT_URI=https://openvibe.vip/auth/callback
# Signs the pages' anti-forgery tokens (required in production): openssl rand -hex 32
VIP_FORM_SECRET=
# Network roles that manage network plans and see any creator's members
VIP_STAFF_ROLES=admin

# ── OpenVibe.Billing (entitlement truth, checkout, cancel) ──
BILLING_URL=http://127.0.0.1:4600
# BILLING_AUDIENCE=openvibe.billing
# VIP_BILLING_TIMEOUT_MS=5000
# Providers offered on plan pages (must be enabled on Billing); `credit` pays from Vibes credit.
# Leave EMPTY until Billing is authoritative (Wave 8 cutover): checkout is then closed.
VIP_CHECKOUT_PROVIDERS=
# Turns Billing's PowerChat checkout_ref into a link: {ref} and {cents}
VIP_POWERCHAT_LINK_TEMPLATE=
# VIP_BILLING_RATES_TTL_MS=300000

# ── Entitlement projection ───────────────────────────────
# A projection answer is trusted at most this long after VIP last heard from Billing (and never
# past the paid period's end); within the grace a projection-only check still answers (stale),
# after it VIP answers "unknown" until Billing confirms.
VIP_PROJECTION_MAX_AGE_MS=900000
VIP_PROJECTION_GRACE_MS=60000

# ── OpenVibe.Events ──────────────────────────────────────
# Outbox relay (vip.plan.published, vip.membership.changed); off when empty
EVENTS_URL=
# EVENTS_RELAY_INTERVAL_MS=2000
# Signing secret of VIP's Billing-event subscriptions (scripts/subscribe.js); comma-separate to rotate
VIP_EVENTS_SECRET=

# ── Jobs ─────────────────────────────────────────────────
# VIP_JOBS=off
# VIP_REFRESH_INTERVAL_MS=60000

# ── Public card, badge and widget (/embed) ───────────────
# The widget's CSP frame-ancestors: any site by default (it is meant to be embedded); e.g.
# "https://openvibe.live https://*.openvibe.network" to restrict it. The rest of VIP stays 'self'.
# VIP_WIDGET_FRAME_ANCESTORS=*
# How long a creator's member count (from Billing) is reused
# VIP_MEMBER_COUNT_TTL_MS=300000
