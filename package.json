{
  "name": "openvibe-vip",
  "version": "0.1.0",
  "private": true,
  "description": "OpenVibe.VIP \u2014 memberships on the OpenVibe network: plans, versioned plan terms, perks and gated-resource policy. Billing holds the entitlement truth; VIP holds plans and perks.",
  "main": "server/index.js",
  "exports": {
    ".": "./server/index.js",
    "./client": "./client/vip-client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node server/index.js",
    "test": "node test/run.js",
    "subscribe": "node scripts/subscribe.js",
    "test:pg": "VIP_TEST_STORE=pg node test/run.js"
  },
  "keywords": [
    "openvibe",
    "vip",
    "memberships",
    "entitlements"
  ],
  "author": "OpenVibers",
  "license": "AGPL-3.0-only",
  "repository": "github:OpenVibers/OpenVibe.VIP",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "iovalkey": "^0.4.0",
    "multer": "^2.5.0",
    "openvibe-contracts": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.contracts/archive/v0.443.0.tar.gz",
    "openvibe-sdk": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.sdk/archive/v0.177.0.tar.gz",
    "openvibe-shared": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.shared/archive/v4.320.0.tar.gz",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "jsonwebtoken": "^9.0.2"
  }
}
